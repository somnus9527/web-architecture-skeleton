{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter example-app dev",
    "build": "pnpm --filter example-app build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --parallel test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check": "pnpm check:workspace && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^17.14.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  }
}
