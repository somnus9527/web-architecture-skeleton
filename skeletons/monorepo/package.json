{
  "name": "monorepo-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format && prettier --write .",
    "format:check": "pnpm -r --if-present format:check && prettier --check .",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs --tracked",
    "check": "pnpm check:workspace && pnpm typecheck && pnpm lint && pnpm check:hygiene && pnpm test && pnpm format:check",
    "prepare": "husky",
    "verify:push": "pnpm check",
    "verify:push:changed": "pnpm check:workspace && pnpm check:hygiene"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,md,yaml,yml}": "prettier --write"
  }
}
