# 复制成对应环境的 .env.<env> 并替换占位值。切勿提交真实密钥。
# 仅 .env.example 与 .env.mock 入库；.env.dev / .env.test / .env.prod 由部署期注入。

APP_ENV=mock
APP_ORIGIN=http://127.0.0.1:3001
PORT=3001
BACKEND_API_BASE_URL=https://api.example.com
PRISM_MOCK_BASE_URL=http://127.0.0.1:4011
LOG_LEVEL=debug
SESSION_COOKIE_NAME=ssr_app_auth
SESSION_COOKIE_SECURE=false
CSRF_ENABLED=false
NEXT_PUBLIC_APP_ENV=mock
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3001

# 部署脚本默认由 PROJECT_ID 派生 PM2 名称和日志目录。
PROJECT_ID=ssr-app
# PM2_APP_NAME=ssr-app-web
# PM2_LOG_DIRECTORY=/data/logs/ssr-app-web
# PM2_ENV_ALLOWLIST=LOG_LEVEL
# PM2_KILL_TIMEOUT_MS=30000
# PM2_MIN_UPTIME_MS=10000
# PM2_MAX_RESTARTS=10
# PM2_RESTART_BACKOFF_MS=100
# PM2_MAX_MEMORY_RESTART=768M
# PM2_HEALTHCHECK_URL=http://127.0.0.1:3001/ssr-app-api/health
# PM2_HEALTHCHECK_ATTEMPTS=20
# PM2_HEALTHCHECK_INTERVAL_SECONDS=1
# PM2_SAVE_AFTER_HEALTH=true

# NEXT_DEPLOYMENT_ID 不写入环境文件：development 不需要；production 构建由 CI 注入或脚本自动生成。

# Server Action key 必须是解码后 16 / 24 / 32 字节的 base64 AES key。
# 示例 key，仅用于骨架构建；正式环境必须替换为环境实际 key。
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
