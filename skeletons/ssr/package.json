{
  "name": "ssr-app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm build:prod",
    "build:dev": "node scripts/run-next-with-env.mjs .env.dev build --webpack && node scripts/copy-standalone-assets.mjs",
    "build:dist": "pnpm build:dist:prod",
    "build:dist:dev": "pnpm build:dev && node scripts/package-pm2-dist.mjs",
    "build:dist:prod": "pnpm build:prod && node scripts/package-pm2-dist.mjs",
    "build:dist:test": "pnpm build:test && node scripts/package-pm2-dist.mjs",
    "build:prod": "node scripts/run-next-with-env.mjs .env.prod build --webpack && node scripts/copy-standalone-assets.mjs && node scripts/check-licenses.mjs --emit .next/standalone/THIRD_PARTY_NOTICES.md",
    "build:release": "bash scripts/build.sh",
    "build:test": "node scripts/run-next-with-env.mjs .env.test build --webpack && node scripts/copy-standalone-assets.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:a11y": "node scripts/check-a11y.mjs --tracked",
    "check:architecture": "vitest run src/test/architecture",
    "check:architecture:full": "vitest run src/test/architecture",
    "check:changed": "node scripts/check-changed.mjs",
    "check:contract": "node scripts/check-contract-drift.mjs",
    "check:gates": "node scripts/verify-gates.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs --tracked",
    "check:i18n": "node scripts/check-i18n-copy.mjs --tracked",
    "check:logs": "node scripts/check-logging.mjs --tracked",
    "check:error-codes": "node scripts/generate-error-codes.mjs",
    "error-codes:table": "node scripts/generate-error-codes.mjs --write",
    "check:security": "node scripts/check-security.mjs --tracked",
    "check:seo": "node scripts/check-seo-routing.mjs --tracked",
    "check:seo:content": "node scripts/check-seo-content.mjs --tracked",
    "check:seo:runtime": "node scripts/check-seo-runtime.mjs",
    "check:ui": "node scripts/check-ui-boundary.mjs --tracked",
    "deploy": "bash scripts/deploy.sh",
    "dev": "pnpm dev:mock",
    "dev:dev": "node scripts/run-next-with-env.mjs .env.dev dev -H 127.0.0.1",
    "dev:mock": "concurrently -k \"pnpm mock:serve\" \"node scripts/run-next-with-env.mjs .env.mock dev -H 127.0.0.1\"",
    "dev:test": "node scripts/run-next-with-env.mjs .env.test dev -H 127.0.0.1",
    "env:init": "node scripts/init-local-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "mock:check": "node scripts/check-openapi-mock.mjs",
    "mock:serve": "prism mock mock/openapi.yaml --host 127.0.0.1 --port 4011",
    "prepare": "husky",
    "quality:check": "pnpm check:gates && pnpm typecheck && pnpm lint && pnpm check:hygiene && pnpm check:licenses && pnpm check:security && pnpm check:seo && pnpm check:ui && pnpm check:logs && pnpm check:error-codes && pnpm check:i18n && pnpm check:a11y && pnpm mock:check && pnpm check:contract && pnpm test:coverage && pnpm format:check && pnpm build:prod && pnpm check:sri",
    "start:prod": "node .next/standalone/server.js",
    "test:coverage": "vitest run --coverage",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:sri": "node scripts/check-sri.mjs --source src",
    "licenses:notice": "node scripts/check-licenses.mjs --write-notice",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "typecheck": "tsc -b"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@fontsource/inter": "^5.2.8",
    "antd": "^6.7.2",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.79.0",
    "next": "^16.2.9",
    "next-intl": "4.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.65.1",
    "@stoplight/prism-cli": "^5.15.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "^4.0.15",
    "yaml": "^2.8.2"
  }
}
