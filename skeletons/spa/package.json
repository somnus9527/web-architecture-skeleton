{
  "name": "spa-app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm build:prod",
    "build:dev": "pnpm typecheck && node scripts/run-vite-with-env.mjs .env.dev build --mode dev",
    "build:prod": "pnpm typecheck && node scripts/run-vite-with-env.mjs .env.prod build --mode prod && node scripts/check-licenses.mjs --emit dist/THIRD_PARTY_NOTICES.md",
    "build:release": "bash scripts/build.sh",
    "build:test": "pnpm typecheck && node scripts/run-vite-with-env.mjs .env.test build --mode test",
    "check:a11y": "node scripts/check-a11y.mjs --tracked",
    "check:architecture": "vitest run src/test/architecture",
    "check:architecture:full": "vitest run src/test/architecture",
    "check:changed": "node scripts/check-changed.mjs",
    "check:contract": "node scripts/check-contract-drift.mjs",
    "check:gates": "node scripts/verify-gates.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs --tracked",
    "check:i18n": "node scripts/check-i18n-copy.mjs --tracked",
    "check:logs": "node scripts/check-logging.mjs --tracked",
    "check:error-codes": "node scripts/generate-error-codes.mjs",
    "error-codes:table": "node scripts/generate-error-codes.mjs --write",
    "check:security": "node scripts/check-security.mjs --tracked",
    "check:seo": "node scripts/check-seo-routing.mjs --tracked",
    "check:seo:content": "node scripts/check-seo-content.mjs --tracked",
    "check:ui": "node scripts/check-ui-boundary.mjs --tracked",
    "deploy": "bash scripts/deploy.sh",
    "dev": "pnpm dev:mock",
    "dev:dev": "vite --host 127.0.0.1 --mode dev",
    "dev:mock": "concurrently -k -n mock,vite -c magenta,green \"pnpm mock:dev\" \"node --env-file=.env.mock scripts/start-vite-mock.mjs\"",
    "dev:test": "vite --host 127.0.0.1 --mode test",
    "dev:vite": "pnpm dev:dev",
    "env:init": "node scripts/init-local-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint-staged": "lint-staged",
    "mock:check": "node scripts/check-openapi-mock.mjs",
    "mock:dev": "node --env-file=.env.mock scripts/start-prism-mock.mjs",
    "mock:serve": "node --env-file=.env.mock scripts/start-prism-mock.mjs",
    "prepare": "husky",
    "preview": "vite preview",
    "quality:check": "pnpm check:gates && pnpm typecheck && pnpm lint && pnpm check:hygiene && pnpm check:licenses && pnpm check:security && pnpm check:seo && pnpm check:ui && pnpm check:logs && pnpm check:error-codes && pnpm check:i18n && pnpm check:a11y && pnpm mock:check && pnpm check:contract && pnpm test:coverage && pnpm format:check && pnpm build:prod && pnpm check:sri",
    "test:coverage": "vitest run --coverage",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:sri": "node scripts/check-sri.mjs --html dist",
    "licenses:notice": "node scripts/check-licenses.mjs --write-notice",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "test:architecture": "vitest run src/test/architecture",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "antd": "^6.7.2",
    "dompurify": "^3.5.0",
    "i18next": "^27.2.4",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^7.18.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stoplight/prism-cli": "^5.15.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.8.4",
    "terser": "^5.51.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "^8.0.12",
    "vitest": "^4.0.15",
    "yaml": "^2.8.2"
  }
}
