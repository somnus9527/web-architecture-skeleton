{
  "name": "rn-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs --tracked",
    "env:init": "node scripts/init-local-env.mjs",
    "prepare": "husky",
    "test": "jest --ci"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tanstack/react-query": "5.108.3",
    "expo": "^58.0.26",
    "expo-constants": "^58.0.16",
    "expo-linking": "^58.0.17",
    "expo-router": "^58.0.32",
    "expo-secure-store": "^58.0.3",
    "expo-status-bar": "^58.0.5",
    "i18next": "27.2.4",
    "react": "19.3.1",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "prettier": "^3.8.4",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  }
}
