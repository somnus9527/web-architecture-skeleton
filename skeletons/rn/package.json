{
  "name": "rn-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "android": "expo start --android",
    "check:gates": "node scripts/verify-gates.mjs",
    "dev": "pnpm run dev:development",
    "dev:development": "node --env-file=env/.env.development scripts/dev-env.mjs",
    "dev:mock": "node --env-file=env/.env.mock scripts/dev-env.mjs --lan",
    "dev:staging": "node --env-file=env/.env.staging scripts/dev-env.mjs",
    "dev:test": "node --env-file=env/.env.test scripts/dev-env.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs --tracked",
    "check:logs": "node scripts/check-logging.mjs --tracked",
    "env:init": "node scripts/init-local-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky",
    "quality:check": "pnpm check:gates && pnpm typecheck && pnpm lint && pnpm check:hygiene && pnpm check:logs && pnpm test:coverage && pnpm format:check",
    "start": "expo start",
    "test:coverage": "jest --ci --coverage",
    "test": "jest --ci",
    "typecheck": "tsc --noEmit",
    "build:development": "node --env-file=env/.env.development scripts/build-env.mjs",
    "build:mock": "node --env-file=env/.env.mock scripts/build-env.mjs",
    "build:staging": "node --env-file=env/.env.staging scripts/build-env.mjs",
    "build:test": "node --env-file=env/.env.test scripts/build-env.mjs",
    "build:production": "node --env-file=env/.env.production scripts/build-env.mjs",
    "verify:push": "pnpm check:gates && pnpm typecheck && pnpm lint && pnpm check:hygiene && pnpm check:logs && pnpm test && pnpm format:check",
    "verify:push:changed": "pnpm check:gates && pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.108.3",
    "expo": "^58.0.26",
    "expo-constants": "^58.0.16",
    "expo-image": "~58.0.18",
    "expo-linking": "^58.0.17",
    "expo-router": "^58.0.32",
    "expo-secure-store": "^58.0.3",
    "expo-status-bar": "^58.0.5",
    "i18next": "27.2.4",
    "react": "19.3.1",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/runtime": "^8.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~58.0.26",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "prettier": "^3.8.4",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  }
}
